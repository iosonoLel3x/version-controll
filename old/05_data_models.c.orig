#include <stdio.h>
#include <stdint.h>

static const char* detect_model(void) {
    size_t si = sizeof(int);
    size_t sl = sizeof(long);
    size_t sp = sizeof(void*);

    if (si == 4 && sl == 4 && sp == 4) return "ILP32 (tipico 32-bit)";
    if (si == 4 && sl == 8 && sp == 8) return "LP64 (tipico Linux/macOS 64-bit)";
    if (si == 4 && sl == 4 && sp == 8) return "LLP64 (tipico Windows 64-bit)";
    return "modello non riconosciuto (o non tipico)";
}
int main(void) {
    printf("sizeof(int)   = %zu\n", sizeof(int));
    printf("sizeof(long)  = %zu\n", sizeof(long));
    printf("sizeof(void*) = %zu\n", sizeof(void*));
    printf("=> %s\n", detect_model());

    // Nota: in C, non assumere che long == 8 su 64-bit.
    // Per dimensioni: usa size_t. Per puntatori come interi: intptr_t/uintptr_t.
    printf("sizeof(size_t)   = %zu\n", sizeof(size_t));
    printf("sizeof(intptr_t) = %zu\n", sizeof(intptr_t));

    return 0;
}
